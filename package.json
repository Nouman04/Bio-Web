{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "css": "tailwindcss -c tailwind.config.js -i resources/css/app.css -o public/css/app.css --minify",
        "css:watch": "tailwindcss -c tailwind.config.js -i resources/css/app.css -o public/css/app.css --watch",
        "css:public": "tailwindcss -c tailwind.public.config.js -i resources/css/app.css -o public/css/public.css --minify",
        "icons": "php scripts/build-icon-font.php",
        "assets": "npm run css && npm run css:public && npm run css:auth && npm run icons",
        "css:auth": "tailwindcss -c tailwind.auth.config.js -i resources/css/app.css -o public/css/auth.css --minify"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.3.3",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-echo": "^2.4.0",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "pusher-js": "^8.6.0",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.7"
    }
}
